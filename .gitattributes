# 统一行尾：文本文件一律 LF（配合 .editorconfig）
* text=auto eol=lf

# 脚本显式 LF（避免 Windows 检出 CRLF 导致 bash 语法错误）
*.sh text eol=lf
*.py text eol=lf

# 二进制文件不进行行尾转换
*.pkl binary
*.db binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# 其余常见二进制格式
*.pdf binary
*.doc binary
*.xlsx binary
*.zip binary
*.rar binary
*.tar binary
*.gz binary
*.7z binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.eot binary
